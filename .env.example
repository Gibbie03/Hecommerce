# Local Postgres (see docs/SUPABASE_MIGRATION.md for moving to hosted Supabase)
DATABASE_URL=postgresql://icommerce:icommerce@localhost:5432/icommerce

# Session signing secret for the email-OTP auth cookie (any long random string)
SESSION_SECRET=dev-only-change-me-before-any-real-deployment

# Resend (https://resend.com) — required to actually send verification/OTP emails.
# Leave unset in local dev; endpoints degrade to a clear "not configured" response.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Icommerce <onboarding@icommerce.ng>

# Base URL used in emails and for building absolute links
APP_URL=http://localhost:3000
